[Unit]
Description=Navidrome container
RequiresMountsFor=/mnt/ftp

[Install]
WantedBy=default.target

[Container]
Environment=ND_CONFIGFILE=/etc/navidrome/navidrome.toml
Image=navidrome/navidrome:pr-6222
Pull=newer
UserNS=keep-id
PublishPort=4533:4533
Volume=/mnt/ftp/music:/music:ro,z
Volume=/mnt/ftp/db_backup:/db_backup:z
Volume=/opt/navidrome/data:/data:z
Volume=/opt/navidrome/navidrome.toml:/etc/navidrome/navidrome.toml:ro,z

[Service]
Restart=on-failure
TimeoutStartSec=30

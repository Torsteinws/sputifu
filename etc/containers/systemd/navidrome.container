[Unit]
Description=Navidrome container
Requires=mnt-ftp.mount

[Container]
Environment=ND_DEFAULTDOWNSAMPLINGFORMAT=opus ND_AGENTS=lastfm
Image=navidrome/navidrome:latest
Pull=always
UserNS=keep-id
PublishPort=4533:4533 #1st number is published port, can be change or set yourself
Volume=/mnt/ftp/music:/opt/navidrome/music:ro,z
Volume=/mnt/ftp/db_backup:/opt/navidrome/db_backup:z
Volume=/opt/navidrome/data:/opt/navidrome/data:z
Volume=/opt/sputifu/navidrome.toml:/etc/navidrome/navidrome.toml:ro,z

[Service]
Restart=on-failure
TimeoutStartSec=30

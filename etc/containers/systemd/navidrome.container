[Unit]
Description=Navidrome container
Requires=mnt-ftp.mount

[Container]
Environment=ND_DEFAULTDOWNSAMPLINGFORMAT=opus ND_AGENTS=lastfm ND_CONFIGFILE=/etc/navidrome/navidrome.toml
Image=navidrome/navidrome:latest
Pull=always
UserNS=keep-id
PublishPort=4533:4533
Volume=/mnt/ftp/music:/music:ro,z
Volume=/mnt/ftp/db_backup:/db_backup:z
Volume=/opt/navidrome/data:/data:z
Volume=/opt/sputifu/navidrome.toml:/etc/navidrome/navidrome.toml:ro,z

[Service]
Restart=on-failure
TimeoutStartSec=30
